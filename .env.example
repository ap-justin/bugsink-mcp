# runtime secrets, pushed to Fly by ./scripts/push-env.sh
#
#   cp .env.example .env    # then fill in and run ./scripts/push-env.sh
#
# non-secret settings (BUGSINK_URL, PUBLIC_HOST) live in fly.toml instead

# ---- Talking to Bugsink ----------------------------------------------------
# a Bugsink API token. create one from the "Tokens" menu in the Bugsink UI;
# deleting it there instantly cuts the MCP server off.

BUGSINK_TOKEN=

# ---- Talking to Claude -----------------------------------------------------
# typed on the connector's login page. this single password is what stands
# between the public internet and your error data, so make it a long random one.
# at least 20 characters, or the server refuses to start. failed attempts are rate
# limited per source address and globally, so a wrong one locks the page briefly.
# changing it does not sign out existing connectors. to do that, open
# https://<PUBLIC_HOST>/logout and enter the password: it revokes every token the
# server has issued, and registered clients can reconnect with the new one.

MCP_PASSWORD=
